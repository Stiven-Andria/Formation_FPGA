start_gui
open_project SoCora.xpr
update_compile_order -fileset sources_1
# Disabling source management mode.  This is to allow the top design properties to be set without GUI intervention.
set_property source_mgmt_mode None [current_project]
set_property top tb_environnement [get_filesets sim_1]
set_property top_lib xil_defaultlib [get_filesets sim_1]
# Re-enabling previously disabled source management mode.
set_property source_mgmt_mode All [current_project]
update_compile_order -fileset sim_1
launch_simulation
open_wave_config /mnt/isaac_sbay0/lbo-ws/Projects/DVR-008-002/Base_Design_Project/Reference_design_project_2020.2/src/sim/tb_socora_gpio_behav.wcfg
source tb_environnement.tcl
run 50us
run 50ms
run 50ms
add_force {/tb_environnement/u_driver/rst_i} -radix hex {1 0ns}
add_force {/tb_environnement/u_monitor/rst_i} -radix hex {1 0ns}
run 50ms
run 500ms
restart
run 50ms
add_bp {/mnt/isaac_sbay0/lbo-ws/Projects/DVR-008-002/Base_Design_Project/Reference_design_project_2020.2/src/sim/tb_environnement.vhd} 231
run 500ms
run 500ms
run 500ms
run 500ms
