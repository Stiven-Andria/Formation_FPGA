restart
run 500ms
run 500ms
run 500ms
run 500ms
run 500ms
run 500ms
add_bp {/mnt/isaac_sbay0/lbo-ws/Projects/DVR-008-002/Base_Design_Project/Reference_design_project_2020.2/src/sim/tb_environnement.vhd} 218
run 500ms
run 500ms
run 500ms
add_bp {/mnt/isaac_sbay0/lbo-ws/Projects/DVR-008-002/Base_Design_Project/Reference_design_project_2020.2/src/sim/tb_environnement.vhd} 216
