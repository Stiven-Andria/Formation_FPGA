<?xml version="1.0" encoding="UTF-8"?>
<sdx:platform sdx:vendor="xilinx.com"
              sdx:library="sdx"
              sdx:name="SoCora"
              sdx:version="1.0"
              sdx:schemaVersion="1.0"
              xmlns:sdx="http://www.xilinx.com/sdx">
    <sdx:description>
SoCora
    </sdx:description>
    <sdx:systemConfigurations sdx:defaultConfiguration="SoCora">
        <sdx:configuration sdx:name="SoCora"
                           sdx:displayName="SoCora"
                           sdx:defaultProcessorGroup="standalone_domain"
                           sdx:runtimes="cpp">
            <sdx:description>SoCora</sdx:description>
            <sdx:bootImages sdx:default="standard">
                <sdx:image sdx:name="standard"
                            sdx:bif="SoCora/boot/SoCora.bif"
                            sdx:readme="SoCora/boot/generic.readme"
                            sdx:qemuArguments="SoCora/qemu/qemu_args.txt"
                            />
                <sdx:image sdx:name="standalone_domain"
                            sdx:bif="SoCora/boot/SoCora.bif"
                            sdx:readme="SoCora/boot/generic.readme"
                            sdx:qemuArguments="SoCora/standalone_domain/qemu/qemu_args.txt"
                            />
            </sdx:bootImages>
            <sdx:processorGroup sdx:name="standalone_domain"
                                sdx:displayName="standalone_domain"
                                sdx:cpuType="cortex-a9"
                                sdx:cpuInstance="ps7_cortexa9_0">
                <sdx:os sdx:name="standalone"
                        sdx:displayName="standalone"
                        sdx:bspLibraryPaths="SoCora/standalone_domain/bsplib/lib"
                        sdx:bspIncludePaths="SoCora/standalone_domain/bspinclude/include"
                        sdx:bspConfig="SoCora/standalone_domain/system.mss"
                />
            </sdx:processorGroup>
        </sdx:configuration>
    </sdx:systemConfigurations>
</sdx:platform>
